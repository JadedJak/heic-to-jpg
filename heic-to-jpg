#!/bin/bash
# Convert HEIC/HEIF/WebP files to JPG next to the originals (originals kept, EXIF kept).
ok=0; failed=()
for f in "$@"; do
  base="${f%.*}"; out="$base.jpg"; n=1
  while [ -e "$out" ]; do out="$base-$n.jpg"; n=$((n+1)); done
  case "${f##*.}" in
    [Ww][Ee][Bb][Pp])
      # first frame only (animated WebP), transparency flattened onto white
      cmd=(magick "${f}[0]" -background white -alpha remove -alpha off -quality 92 "$out") ;;
    *)
      cmd=(heif-convert -q 92 "$f" "$out") ;;
  esac
  if "${cmd[@]}" >/dev/null 2>&1; then ok=$((ok+1)); else rm -f "$out"; failed+=("${f##*/}"); fi
done
if [ ${#failed[@]} -eq 0 ]; then
  notify-send -i image-jpeg -a Dolphin "Converted to JPG" "$ok file(s) converted"
else
  notify-send -u critical -i dialog-error -a Dolphin "JPG conversion" "$ok converted, ${#failed[@]} failed: ${failed[*]}"
fi
